#!/bin/bash
#
# /usr/local/bin/vpn-build          (dom0)
#
# usage: vpn-build [<path-under-/home/user>]     default: vpn-selection.conf
#
# End-to-end build of ONE VPN qube. Run from dom0 only. This is the single
# command that determines where everything comes from -- neither
# salt-configs-vm nor vpn-config-files-vm can name the other, and neither can
# name the target.
#
# Order matters: the firewall is applied BEFORE any config is pushed and
# before the disposable is ever started, so the qube is never briefly open.
#
# To build several qubes from a directory of numbered configs, use
# vpn-build-all, which validates the whole set first and then calls this once
# per config.
#
# The path argument is also useful by hand, to rebuild ONE member of a set
# without touching the others:
#
#     vpn-build vpn-configs/20-de77.conf
#
# uplink is read from that file as usual, so a chained qube stays chained.
# What is lost is the cross-config validation: seeing one file, this cannot
# check the mtu against its parent or notice a name collision with another
# config. Run "vpn-build-all -n" first if more than that one file changed.

set -euo pipefail

die() { echo "vpn-build: $*" >&2; exit 1; }
step() { echo; echo "== $* =="; }

VPNCONF_VM="vpn-config-files-vm"

# Everything below drives qubesctl, qvm-firewall and qrexec as dom0. Running it
# anywhere else fails partway with confusing errors rather than up front.
[ "$(hostname)" = "dom0" ] || die "must be run in dom0 (hostname is '$(hostname)')"

# Writing the pillar needs root, and so does qubesctl. Checked up front: without
# this the first failure is a bare "Permission denied" from a redirect several
# steps in, which says nothing about what to do. Refuse early and name the fix.
[ "$(id -u)" -eq 0 ] || die "must be run as root -- try: sudo $0 $*"

# No qrexec call here should be able to hang the build indefinitely. The config
# push moves real files, so it gets a longer budget than the metadata calls.
QREXEC_TIMEOUT=120

CONFIG_REL="${1:-vpn-selection.conf}"

step "1/8  validate parameters from salt-configs-vm  ($CONFIG_REL)"
# vpn-params-fetch validates the path as well as the contents; nothing here
# needs to pre-screen it.
/usr/local/bin/vpn-params-fetch "$CONFIG_REL"

read_pillar() { grep -E "^  $1:" /srv/user_pillar/vpn.sls | sed -E "s/^  $1: *'?([^']*)'?$/\1/"; }
country=$(read_pillar country)
server=$(read_pillar server)
mode=$(read_pillar mode)
transport=$(read_pillar transport)
uplink=$(read_pillar uplink)
dvm=$(read_pillar dvm_template)
disp=$(read_pillar dispvm)
[ -n "$dvm" ] && [ -n "$disp" ] || die "could not read derived names from pillar"
[ -n "$transport" ] || die "could not read transport from pillar"
[ -n "$uplink" ] || die "could not read uplink from pillar"

# Rebuilding a running disposable is broken in both directions, so refuse it
# rather than half-apply and leave the qube worse than before:
#
#   - configs are delivered to the TEMPLATE. A running disposable took its
#     copy of the private volume at boot, so it keeps the old ones. The
#     rebuild appears to succeed and changes nothing about what is running.
#   - the firewall, however, is applied to the disposable and enforced by its
#     netvm immediately. Rebuilding for a different country therefore drops
#     the endpoint the live tunnel is using, killing an established tunnel
#     while vpn-up is not re-run to replace it.
#
# Net effect: a working qube stops working, downstream qubes lose the network,
# and nothing says why. Nothing leaks -- Layer 1 holds -- but a restart is
# needed to recover, so require it up front instead.
if qvm-check --running --quiet "$disp" 2>/dev/null; then
    downstream=$(qvm-ls --raw-data --fields NAME,NETVM 2>/dev/null \
                 | awk -F'|' -v d="$disp" '$2 == d { print $1 }' | paste -sd' ' -) || downstream=""
    echo "vpn-build: $disp is running. Shut it down before rebuilding:" >&2
    echo "  qvm-shutdown --wait $disp" >&2
    if [ -n "$downstream" ]; then
        echo >&2
        echo "These qubes use it as their uplink and will lose network while it is down:" >&2
        echo "  $downstream" >&2
    fi
    exit 1
fi

step "2/8  create qubes  ($dvm, $disp)"
qubesctl --show-output state.apply vpn

step "3/8  place files inside $dvm"
qubesctl --skip-dom0 --targets="$dvm" --show-output state.apply vpn.vmfiles

step "4/8  fetch and validate endpoints for $country"
if [ "$mode" = "random" ]; then
    mapfile -t endpoints < <(/usr/local/bin/vpn-endpoints-fetch "$country")
else
    mapfile -t endpoints < <(/usr/local/bin/vpn-endpoints-fetch "$country" "$server")
fi
[ "${#endpoints[@]}" -gt 0 ] || die "no endpoints"
echo "${#endpoints[@]} endpoint(s) whitelisted"

step "5/8  apply firewall to $disp  (before any config exists)"
/usr/local/bin/vpn-firewall-apply -p "$transport" "$disp" "${endpoints[@]}"

step "6/8  push configs $VPNCONF_VM -> $dvm"
# The tag set by salt is what the qubes.Filecopy policy keys on. dom0 decides
# who is tagged; the config qube never learns the target from anywhere else.
if [ "$mode" = "random" ]; then sel="ALL"; else sel="$server"; fi
printf '%s %s %s\n' "$dvm" "$country" "$sel" \
    | timeout "$QREXEC_TIMEOUT" \
      qrexec-client -d "$VPNCONF_VM" "DEFAULT:QUBESRPC custom.VpnConfigPush dom0" \
    || die "config push failed (or timed out after ${QREXEC_TIMEOUT}s)"

step "7/8  secure the delivered configs in $dvm"
# qvm-copy-to-vm drops files in the template's home directory with whatever
# mode they had. Move them into the root-owned 0700 directory and clear the
# inbox, so the persistent copy is not left readable in /home/user.
qvm-run --no-gui -u root "$dvm" '
    set -e
    mkdir -p /rw/config/vpn && chmod 700 /rw/config/vpn && chown root:root /rw/config/vpn

    # Clear configs left by a previous build before taking delivery of these.
    #
    # Only *.conf needs this. endpoint-map.txt and auth-user-pass.txt have
    # fixed names, so the mv below overwrites them and they can never go
    # stale; config filenames vary per server, so without this they pile up.
    # A left-behind config is not inert: it joins the random pool, and in
    # specific mode it can be the one selected, aimed at an endpoint dom0 no
    # longer whitelists.
    #
    # Guarded on replacements having actually arrived. A push that reported
    # success but delivered nothing must leave the qube with the configs it
    # had, not with none -- and this runs as root against a directory holding
    # key material, so it refuses to be the thing that empties it.
    if find /home/user/QubesIncoming -type f -name "*.conf" 2>/dev/null | grep -q .; then
        rm -f /rw/config/vpn/*.conf
    else
        echo "no *.conf in the inbox - keeping existing configs" >&2
    fi

    find /home/user/QubesIncoming -type f \
        \( -name "*.conf" -o -name "endpoint-map.txt" -o -name "auth-user-pass.txt" \) \
        -exec mv -t /rw/config/vpn {} + 2>/dev/null || true
    # Filter on -type f rather than globbing. chmod and chown FOLLOW symlinks,
    # and the "find -type f" above only proves the type at the moment find
    # looked: a malicious user in this template could swap a regular file for a
    # symlink before mv renames it, landing a symlink in this directory and
    # having the chmod below re-mode an arbitrary path as root. Re-checking here
    # closes that -- once a file is inside 0700 root-owned storage, an
    # unprivileged user can no longer swap it.
    find /rw/config/vpn -maxdepth 1 -type f \
        -exec chown root:root {} + 2>/dev/null || true
    find /rw/config/vpn -maxdepth 1 -type f -name "*.conf" \
        -exec chmod 600 {} + 2>/dev/null || true
    find /rw/config/vpn -maxdepth 1 -type f -name auth-user-pass.txt \
        -exec chmod 600 {} + 2>/dev/null || true
    find /rw/config/vpn -maxdepth 1 -type f -name endpoint-map.txt \
        -exec chmod 644 {} + 2>/dev/null || true
    # Nothing but regular files belongs here, and the copy above put none there.
    find /rw/config/vpn -maxdepth 1 ! -type f ! -type d -delete 2>/dev/null || true
    rm -rf /home/user/QubesIncoming
' || die "could not secure configs inside $dvm"

step "8/8  check every delivered config has a whitelisted endpoint"
# The pool the qube picks from and the allow list applied at step 5 are derived
# independently: a bare *.conf glob in $VPNCONF_VM against regex-validated
# endpoint-map lines here. vpn-up refuses to pick a config it cannot resolve to
# a whitelisted endpoint, so a mismatch cannot open anything -- but it silently
# shrinks the random pool. This makes it visible now rather than leaving it to
# be handled quietly at some future boot.
#
# Counted in the template because that is where the two sets finally meet;
# nothing else in the pipeline sees both. The counts come from an AppVM, so they
# are validated as integers and only ever reported. dom0 does not act on them.
counts=$(qvm-run --no-gui --pass-io -u root "$dvm" '
    cd /rw/config/vpn 2>/dev/null || { echo "0 0"; exit 0; }
    n=0; m=0
    for f in *.conf; do
        [ -e "$f" ] || continue
        n=$((n + 1))
        [ -f endpoint-map.txt ] || continue
        while read -r name rest; do
            [ "$name" = "$f" ] || continue
            m=$((m + 1))
            break
        done < endpoint-map.txt
    done
    echo "$n $m"
' 2>/dev/null) || counts=""

n_conf=""; n_mapped=""
read -r n_conf n_mapped _ <<< "$counts" || true
# Digits are bounded, not just checked. "^[0-9]+$" accepts a 22-digit reply,
# which then overflows bash arithmetic: "[: integer expected" on stderr and a
# wrong verdict printed after it. Six digits is far beyond any real country
# folder. n_mapped > n_conf is likewise impossible from the counter above, so
# treat it as an unreadable answer rather than reporting "ok" on nonsense.
if [[ "$n_conf" =~ ^[0-9]{1,6}$ ]] && [[ "$n_mapped" =~ ^[0-9]{1,6}$ ]] \
   && [ "$n_mapped" -le "$n_conf" ]; then
    if [ "$n_conf" -eq 0 ]; then
        echo "WARNING: no .conf files found in $dvm:/rw/config/vpn" >&2
    elif [ "$n_mapped" -lt "$n_conf" ]; then
        cat >&2 <<WARN
WARNING: $((n_conf - n_mapped)) of $n_conf delivered configs have no endpoint-map entry.

         vpn-up will refuse to pick them, so the qube stays safe -- but the
         random pool is smaller than the country folder suggests, and those
         configs are dead weight in the template.

         Regenerate the map in the qube where you downloaded the configs:
           tools/build-endpoint-map.sh ~/configs
         copy the folder back into $VPNCONF_VM, then re-run vpn-build.
WARN
    else
        echo "ok: all $n_conf delivered configs have a whitelisted endpoint"
    fi
else
    echo "warning: could not read config counts from $dvm - skipping the check" >&2
fi

# The copy started the template. It is meant never to run, so put it back.
qvm-shutdown --wait "$dvm" || echo "warning: could not shut down $dvm" >&2

cat <<DONE

Build complete.

  dvm template : $dvm      (netvm none, never runs)
  disposable   : $disp     (start this; use it as netvm downstream)
  mode         : $mode ${server:+($server)}
  transport    : $transport
  uplink       : $uplink
  endpoints    : ${#endpoints[@]} whitelisted
DONE

# An uplink of none is a supported choice, not a failure -- but the qube it
# produces cannot reach its endpoint, so say so rather than printing a
# "qvm-start" line that would appear to work and then not.
if [ "$uplink" = "none" ]; then
    cat <<DONE

This qube has NO UPLINK (uplink=none), so the tunnel cannot come up until one
is attached. Everything else is built: firewall applied, configs delivered.

Attach an uplink, then start it:
  qvm-prefs $disp netvm <sys-firewall|another-vpn-qube>
  qvm-start $disp
DONE
else
    cat <<DONE

Next:
  qvm-start $disp
  qvm-prefs <some-qube> netvm $disp
DONE
fi

cat <<DONE

Verify:
  qvm-run $disp 'sudo journalctl -t vpn-up -t qubes-fw-user'
  qvm-run $disp 'sudo nft list chain ip qubes custom-forward'
  qvm-run $disp 'sudo nft list chain ip6 qubes custom-forward'
DONE
