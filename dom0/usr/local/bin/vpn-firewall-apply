#!/bin/bash
#
# /usr/local/bin/vpn-firewall-apply          (dom0)
#
# usage: vpn-firewall-apply [-p udp|tcp] <vm> <ip:port[/proto]> [...]
#
# <vm> must be the NAMED DISPOSABLE. Rules on the dvm template never filter
# anything, because the template's netvm is none and it never runs.
#
# Each endpoint may carry its own protocol as "/udp" or "/tcp". -p sets the
# default for endpoints that do not, which is what a map generated before the
# protocol column existed produces. Per-endpoint protocols matter because a
# country folder can legitimately mix UDP/1194 and TCP/443 servers: one
# blanket protocol whitelists half of such a folder on the wrong one, and
# because the config is chosen at random inside the qube, the result is a
# tunnel that fails on some boots and not others.
#
# Final ruleset:
#   0  drop specialtarget=dns
#   1  drop proto=icmp
#   2..N accept <proto> <endpoint>
#   N+1 drop
#
# The trailing drop has no address family, so it covers IPv6 as well.
#
# Note that dropping DNS means the qube cannot resolve hostnames. That is
# deliberate, and it is why vpn-up rewrites an OpenVPN "remote" to the
# whitelisted IP instead of leaving a hostname in place.

set -euo pipefail

PROTO="udp"
while [ "$#" -gt 0 ]; do
    case "$1" in
        -p) PROTO="${2:?-p needs a value}"; shift 2 ;;
        --) shift; break ;;
        -*) echo "unknown option $1" >&2; exit 1 ;;
        *)  break ;;
    esac
done

[[ "$PROTO" =~ ^(udp|tcp)$ ]] || { echo "proto must be udp or tcp" >&2; exit 1; }

VM="${1:?usage: vpn-firewall-apply [-p udp|tcp] <vm> <ip:port[/proto]> ...}"; shift
[ "$#" -gt 0 ] || { echo "no endpoints given" >&2; exit 1; }

# This is the last gate before an address becomes a firewall rule, so it
# repeats the range and leading-zero checks vpn-endpoints-fetch already does
# rather than assuming its caller. "010.0.0.1" is read as octal by some tools
# and decimal by others; whitelisting it would permit an address nobody chose.
valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o
    for o in "${BASH_REMATCH[@]:1:4}"; do
        [[ "$o" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
        (( o <= 255 )) || return 1
    done
    return 0
}

# Validate EVERY endpoint before touching the live firewall. Applying as we go
# and exiting on the first bad one would leave the qube mid-rewrite: the
# blanket accept from "reset" already deleted, some accepts in place, and the
# terminal drop -- added only after the loop -- never reached. That ruleset has
# no final drop, so it fails open on exactly the path where something was
# already wrong. Building the list first makes a rejected argument a no-op
# against the running qube.
declare -A SEEN=()
RULES=()
for ep in "$@"; do
    # Split the optional "/proto" suffix off first, so the ":" split below is
    # unaffected by it.
    eproto="$PROTO"
    if [[ "$ep" == */* ]]; then
        eproto="${ep##*/}"
        ep="${ep%/*}"
        [[ "$eproto" =~ ^(udp|tcp)$ ]] || { echo "bad proto $eproto" >&2; exit 1; }
    fi

    ip="${ep%:*}"; port="${ep##*:}"
    valid_ipv4 "$ip"                || { echo "bad ip $ip" >&2; exit 1; }
    [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) \
                                    || { echo "bad port $port" >&2; exit 1; }

    # Providers point several configs at one address, so a country's map
    # routinely repeats an endpoint. Each duplicate would be an identical
    # firewall rule and, more to the point, another qvm-firewall round trip --
    # which is the dominant cost of applying a large country. The key includes
    # the protocol: the same host on udp and on tcp is two different rules.
    key="$ip:$port/$eproto"
    [ -z "${SEEN[$key]+x}" ] || continue
    SEEN[$key]=1
    RULES+=("$eproto $ip $port")
done

if (( $# > ${#RULES[@]} )); then
    echo "collapsed $# endpoints to ${#RULES[@]} distinct rules" >&2
fi

qvm-firewall "$VM" reset
# Deterministic: reset leaves exactly one blanket accept at index 0. Delete it
# immediately, while the index is unambiguous -- not after appending rules.
qvm-firewall "$VM" del --rule-no 0

for rule in "${RULES[@]}"; do
    read -r eproto ip port <<< "$rule"
    qvm-firewall "$VM" add accept proto="$eproto" dst4="$ip" dstports="$port"
done

qvm-firewall "$VM" add --before 0 drop proto=icmp
qvm-firewall "$VM" add --before 0 drop specialtarget=dns
qvm-firewall "$VM" add drop

# Label the default, not "the" protocol: the rules below may carry a mix, and
# the listing shows each rule's own proto anyway.
echo "--- $VM firewall (default proto $PROTO) ---"
qvm-firewall "$VM" list

# Assert the last rule is an unconditional drop, rather than merely printing it.
last=$(qvm-firewall "$VM" list | tail -n 1)
case "$last" in
    *drop*) ;;
    *) echo "ASSERTION FAILED: last rule is not a drop: $last" >&2; exit 1 ;;
esac
echo "ok: terminal drop present"
