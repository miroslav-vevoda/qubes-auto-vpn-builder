# /srv/user_pillar/vpn.sls
#
# DO NOT EDIT BY HAND. Generated by /usr/local/bin/vpn-params-fetch, which
# reads salt-configs-vm:/home/user/vpn-selection.conf and validates every
# field before writing it here. This file is an example of the output.

vpn:
  provider: nordvpn
  protocol: wireguard          # wireguard | openvpn
  transport: udp               # udp | tcp -- what the dom0 firewall whitelists
  mtu: 1420
  mode: specific               # specific | random
  country: uk
  server: uk123                # empty when mode is random
  dvm_template: nordvpn-uk123-vpn-dvm
  dispvm: nordvpn-uk123-vpn
  base_template: fedora-42-xfce
  uplink: sys-firewall         # sys-firewall | another vpn qube | none
                               # (defaults to none when the selection file
                               #  omits it -- never to sys-firewall)
  vpn_if: wireguard            # wireguard | vpn0
